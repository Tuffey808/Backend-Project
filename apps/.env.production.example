# Production environment for `docker compose -f docker-compose.prod.yml`
# Copy: cp .env.production.example .env.production
# Usage: docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-random-32-chars-minimum
JWT_EXPIRES_IN=7d

# Public URLs (no trailing slash)
PUBLIC_API_URL=https://api.gmall.sa
NEXT_PUBLIC_API_URL=https://api.gmall.sa
CORS_ORIGIN=https://portal.gmall.sa,https://gmall.sa

# Tap Payments — set TAP_USE_SANDBOX=false for live payments
TAP_USE_SANDBOX=true
TAP_SANDBOX_SECRET_KEY=
TAP_PRODUCTION_SECRET_KEY=
TAP_MERCHANT_ID=

# Optional: run seed once on fresh DB (demo accounts — disable after first deploy)
SEED_DB=false

# Firebase Cloud Messaging (optional — enables real push delivery)
FCM_SERVER_KEY=
